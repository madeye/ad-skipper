<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the accessibility service alive as a foreground service so
         aggressive OEM task killers (MIUI/HyperOS etc.) don't reap it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Splash-window wake lock: HyperOS GreezeManager cgroup-freezes this
         process ~0.5s after the last accessibility event; a silent video
         splash ad (e.g. Douban) emits none, so the poll loop would stop
         getting CPU mid-window. Held only for the splash window. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Thaw-watchdog alarm: alarm delivery is the only mechanism HyperOS
         GreezeManager reliably thaws a frozen process for; without it the
         service stays frozen after a screen-off period and misses app
         launches entirely. USE_EXACT_ALARM is auto-granted (app is
         sideload-distributed; Play would restrict this permission). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- List installed apps for the whitelist picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- home apps, for the service's always-on launcher whitelist -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- browser apps, for the service's always-on browser exclusion -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".AdSkipperApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdSkipper">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TestAdActivity"
            android:exported="false" />

        <service
            android:name="com.adskipper.core.service.AdSkipperService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibility ad-skip keepalive" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
